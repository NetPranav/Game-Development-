# ==========================================
# Unreal Engine Ignore Rules
# ==========================================
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/
**/.vs/
**/*.VC.db
**/*.opendb
**/*.vsconfig
**/*.log
**/*.tmp

# Build & compiler artifacts
*.pdb
*.obj
*.pch
*.lib
*.exp
*.res
*.sarif
*.rsp
*.tlog
*.suo
*.user
*.ilk

# Raw 3D files exceeding GitHub 100MB limit
*.blend
*.blend1

# Heavy 3rd-party binary assets (>8GB sample locomotion assets)
# Keep custom Robot Rumble game assets (44MB)
GameAnimationSample/Content/*
!GameAnimationSample/Content/RR/

# ==========================================
# Blockchain (Sui & Sidecar) Ignore Rules
# ==========================================
# CRITICAL: NEVER commit private keys or local environment secrets
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Node.js dependencies
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Sui Move build outputs
Sui/contracts/build/
Sui/contracts/Published.toml

# IDE & OS caches
.vscode/
.idea/
.claude/
.gemini/
.DS_Store
Thumbs.db

# Raw downloaded sources (re-importable; the imported .uasset files under Content/RR are tracked)
GameAnimationSample/ExternalAnims/**
GameAnimationSample/ExternalAudio/**
GameAnimationSample/ExternalModels/**
!GameAnimationSample/ExternalAnims/**/
!GameAnimationSample/ExternalAudio/**/
!GameAnimationSample/ExternalModels/**/
!GameAnimationSample/External*/**/LICENSE*
!GameAnimationSample/External*/**/License*
GameAnimationSample/*.zip
GameAnimationSample/*.glb
